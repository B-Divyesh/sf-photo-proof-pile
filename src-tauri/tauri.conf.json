{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proof Pile",
  "version": "0.1.9",
  "identifier": "in.sociobot.photo-proof-pile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:site",
    "frontendDist": "../dist/site"
  },
  "app": {
    "windows": [
      {
        "title": "Proof Pile",
        "width": 1440,
        "height": 920,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com https://api.sociobot.in; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Review photo copies before cleanup",
    "longDescription": "Groups duplicate and similar photos, shows the evidence, and moves reviewed copies into a reversible quarantine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
